# ProxyJump: several hops, tokens, none and a default at the end.

Host multi
    ProxyJump admin@bastion.example.com:2222,jump.example.com

Host tokens
    User ops
    Port 2200
    ProxyJump %r@bastion-%n.example.com:%p

Host internal-*
    HostName %h.corp.example.com
    ProxyJump jump-for-%h

Host direct
    # none wins over the default below, like any first value.
    ProxyJump none

Host *
    ProxyJump default.example.com
